

int concatenatedBinary(int n){
     long long ans = 0;
    int bitLength = 0;

    #define MOD 1000000007  
// 10^9 + 7.

    for(int i = 1; i <= n; i++) {

        if((i & (i - 1)) == 0)
            bitLength++;

        ans = ((ans << bitLength) % MOD + i) % MOD; 
         // to avoid overflow of int 
    }

    return (int) ans;
}

