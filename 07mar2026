#include <string.h>
#include <stdlib.h>

#define MIN(a, b) ((a) < (b) ? (a) : (b))

int minFlips(char * s) {
    int n = strlen(s);
    
    char *doubled_s = (char *)malloc((2 * n + 1) * sizeof(char));
    strcpy(doubled_s, s);
    strcat(doubled_s, s);
    
    int diff1 = 0;
    int diff2 = 0;
    int min_flips = 2 * n; 
    
    for (int i = 0; i < 2 * n; i++) {
        
        char expected1 = (i % 2 == 0) ? '1' : '0';
        char expected2 = (i % 2 == 0) ? '0' : '1';
        
        if (doubled_s[i] != expected1) {
            diff1++;
        }
        if (doubled_s[i] != expected2) {
            diff2++;
        }
        
        if (i >= n) {
            int left_idx = i - n;
            char left_expected1 = (left_idx % 2 == 0) ? '1' : '0';
            char left_expected2 = (left_idx % 2 == 0) ? '0' : '1';
            
            if (doubled_s[left_idx] != left_expected1) {
                diff1--;
            }
            if (doubled_s[left_idx] != left_expected2) {
                diff2--;
            }
        }
        
        if (i >= n - 1) {
            int current_min = MIN(diff1, diff2);
            if (current_min < min_flips) {
                min_flips = current_min;
            }
        }
    }
    
    free(doubled_s);
    
    return min_flips;
}
