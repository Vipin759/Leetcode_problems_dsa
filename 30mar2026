bool checkStrings(char* s1, char* s2) {
    int count[2][26] = {0}; 
    
    for (int i = 0; s1[i] != '\0'; i++) {
        count[i % 2][s1[i] - 'a']++;
        count[i % 2][s2[i] - 'a']--;
    }
    
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 26; j++) {
            if (count[i][j] != 0) {
                return false;
            }
        }
    }
    
    return true;
}
