int maxProductPath(int** grid, int gridSize, int* gridColSize) {
    int m = gridSize;
    int n = gridColSize[0];
    long long MOD = 1000000007;

    long long maxDP[m][n], minDP[m][n];

    maxDP[0][0] = minDP[0][0] = grid[0][0];

    for (int i = 1; i < m; i++)
        maxDP[i][0] = minDP[i][0] = maxDP[i-1][0] * grid[i][0];

    for (int j = 1; j < n; j++)
        maxDP[0][j] = minDP[0][j] = maxDP[0][j-1] * grid[0][j];

    for (int i = 1; i < m; i++) {
        for (int j = 1; j < n; j++) {
            long long val = grid[i][j];
            long long a = maxDP[i-1][j] * val;
            long long b = minDP[i-1][j] * val;
            long long c = maxDP[i][j-1] * val;
            long long d = minDP[i][j-1] * val;

            maxDP[i][j] = (a > b ? a : b) > (c > d ? c : d) ? (a > b ? a : b) : (c > d ? c : d);
            minDP[i][j] = (a < b ? a : b) < (c < d ? c : d) ? (a < b ? a : b) : (c < d ? c : d);
        }
    }

    if (maxDP[m-1][n-1] < 0) return -1;
    return (int)(maxDP[m-1][n-1] % MOD);
}
