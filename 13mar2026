#include <stdbool.h>
#include <math.h>

typedef long long ll;

bool Check(ll mid, int* workerTimes, int size, int mH) {
    ll h = 0;
    
    for (int i = 0; i < size; i++) {
        double t = workerTimes[i];

        h += (ll)((sqrt(1.0 + 8.0 * (mid / t)) - 1.0) / 2.0);
        

        if (h >= mH) {
            return true;
        }
    }
    
    return h >= mH;
}

long long minNumberOfSeconds(int mountainHeight, int* workerTimes, int workerTimesSize) {
    int maxTime = workerTimes[0];
    for (int i = 1; i < workerTimesSize; i++) {
        if (workerTimes[i] > maxTime) {
            maxTime = workerTimes[i];
        }
    }

    ll l = 1;
    ll mH = mountainHeight;
    ll r = (ll)maxTime * mH * (mH + 1) / 2;
    
    ll result = 0;

    while (l <= r) {
        ll mid = l + (r - l) / 2;
        
        if (Check(mid, workerTimes, workerTimesSize, mountainHeight)) {
            result = mid;
            r = mid - 1; 
        } else {
            l = mid + 1; 
        }
    }

    return result;
}
