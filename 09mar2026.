int numberOfStableArrays(int zero, int one, int limit) {
    int MOD = 1000000007;
    long long dp[205][205][2];
    
    memset(dp, 0, sizeof(dp));

    for (int i = 1; i <= zero && i <= limit; i++) {
        dp[i][0][0] = 1; 
    }
    for (int j = 1; j <= one && j <= limit; j++) {
        dp[0][j][1] = 1; 
    }

    for (int i = 1; i <= zero; i++) {
        for (int j = 1; j <= one; j++) {
            for (int k = 1; k <= i && k <= limit; k++) {
                dp[i][j][0] = (dp[i][j][0] + dp[i - k][j][1]) % MOD;
            }
            for (int k = 1; k <= j && k <= limit; k++) {
                dp[i][j][1] = (dp[i][j][1] + dp[i][j - k][0]) % MOD;
            }
        }
    }

    long long total_stable_arrays = (dp[zero][one][0] + dp[zero][one][1]) % MOD;
    
    return (int)total_stable_arrays;
}
