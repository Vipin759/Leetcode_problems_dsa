#include <stdlib.h>
#include <string.h>

char* findTheString(int** lcp, int lcpSize, int* lcpColSize) {
    int n = lcpSize;
    char* word = (char*)malloc((n + 1) * sizeof(char));
    memset(word, 0, n + 1);
    
    char c = 'a';
    for (int i = 0; i < n; i++) {
        if (word[i] == 0) {
            if (c > 'z') {
                free(word);
                char* empty = (char*)malloc(1);
                empty[0] = '\0';
                return empty;
            }
            for (int j = i; j < n; j++) {
                if (lcp[i][j] > 0) {
                    if (word[j] == 0) {
                        word[j] = c;
                    }
                }
            }
            c++;
        }
    }
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            int expected = 0;
            if (word[i] == word[j]) {
                expected = 1;
                if (i + 1 < n && j + 1 < n) {
                    expected += lcp[i + 1][j + 1];
                }
            }
            if (lcp[i][j] != expected) {
                free(word);
                char* empty = (char*)malloc(1);
                empty[0] = '\0';
                return empty;
            }
        }
    }
    
    return word;
}
