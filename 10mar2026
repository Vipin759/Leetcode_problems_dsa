
int numberOfStableArrays(int zero, int one, int limit) {
    long long (*dp)[one + 1][2] = calloc(zero + 1, sizeof(long long[one + 1][2]));
    
    for (int i = 1; i <= zero && i <= limit; i++)
        dp[i][0][0] = 1;
    
    for (int j = 1; j <= one && j <= limit; j++)
        dp[0][j][1] = 1;
    
    for (int i = 1; i <= zero; i++) {
        for (int j = 1; j <= one; j++) {
            dp[i][j][0] = (dp[i-1][j][0] + dp[i-1][j][1]) % 1000000007;
            if (i > limit)
                dp[i][j][0] = (dp[i][j][0] - dp[i-limit-1][j][1] + 1000000007) % 1000000007;
            
            dp[i][j][1] = (dp[i][j-1][0] + dp[i][j-1][1]) % 1000000007;
            if (j > limit)
                dp[i][j][1] = (dp[i][j][1] - dp[i][j-limit-1][0] + 1000000007) % 1000000007;
        }
    }
    
    long long ans = (dp[zero][one][0] + dp[zero][one][1]) % 1000000007;
    free(dp);
    return (int)ans;
}
